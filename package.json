{
  "name": "sethucms-admin",
  "private": true,
  "version": "0.0.0",
  "description": "Admin panel for SethuCMS",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:embedded": "tsc --noEmit && VITE_API_URL=/ vite build",
    "build:hosted": "tsc --noEmit && VITE_API_URL=ask vite build",
    "build:site": "tsc --noEmit && VITE_BASE=/sethu/ vite build"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^11.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
